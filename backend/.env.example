PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL Lokal - PGlite)
# Data PostgreSQL disimpan langsung di folder lokal: backend/pg_data
# Kamu bisa menentukan custom path jika diperlukan, atau biarkan default (backend/pg_data)
# PG_DATA_DIR=./pg_data

# Email Configuration (Resend - https://resend.com)
RESEND_API_KEY=your-resend-api-key
ADMIN_EMAIL=your-email@gmail.com

